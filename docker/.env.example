# Copy to docker/.env and edit. Never commit docker/.env.
ASHEN_SERVER_NAME=ASHEN SANCTUM
# Anyone with this code can register: set your own, 12 characters or more (the server won't start with
# the placeholder). Leave it empty to let anyone who can reach the server register.
ASHEN_INVITE=change-me-to-something-long
ASHEN_PORT=4747
ASHEN_MAX_GAMES=6
ASHEN_MAX_PLAYERS=32
